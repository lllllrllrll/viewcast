        <mxCell id="table" value="&lt;div style=&quot;text-align:center;font-size:20px;font-weight:700;margin-bottom:12px;&quot;&gt;ViewCast Thumbnail Analyzer — Accuracy Experiment&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:12px;color:#667085;margin-bottom:16px;&quot;&gt;Effective = 7–10 | Average = 4–6 | Ineffective = 1–3&lt;/div&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;8&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;width:100%;font-size:12px;&quot;&gt;&lt;thead&gt;&lt;tr style=&quot;background:#0f8b8d;color:#ffffff;font-weight:700;&quot;&gt;&lt;th style=&quot;width:6%;&quot;&gt;Test&lt;/th&gt;&lt;th style=&quot;width:36%;&quot;&gt;Thumbnail Input&lt;/th&gt;&lt;th style=&quot;width:20%;&quot;&gt;Expected Output&lt;/th&gt;&lt;th style=&quot;width:20%;&quot;&gt;Actual Output&lt;/th&gt;&lt;th style=&quot;width:18%;&quot;&gt;Correct?&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;Clear close-up face&lt;/td&gt;&lt;td&gt;9/10 — Effective&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f6f8fb;&quot;&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;Bold, readable text&lt;/td&gt;&lt;td&gt;9/10 — Effective&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;Strong color contrast&lt;/td&gt;&lt;td&gt;8/10 — Effective&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f6f8fb;&quot;&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;Expressive reaction&lt;/td&gt;&lt;td&gt;8/10 — Effective&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;Relevant product image&lt;/td&gt;&lt;td&gt;8/10 — Effective&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f6f8fb;&quot;&gt;&lt;td&gt;6&lt;/td&gt;&lt;td&gt;Balanced gaming scene&lt;/td&gt;&lt;td&gt;7/10 — Effective&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;7&lt;/td&gt;&lt;td&gt;Simple tutorial graphic&lt;/td&gt;&lt;td&gt;7/10 — Effective&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f6f8fb;&quot;&gt;&lt;td&gt;8&lt;/td&gt;&lt;td&gt;Recognizable logo&lt;/td&gt;&lt;td&gt;7/10 — Effective&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;9&lt;/td&gt;&lt;td&gt;Ordinary video screenshot&lt;/td&gt;&lt;td&gt;6/10 — Average&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f6f8fb;&quot;&gt;&lt;td&gt;10&lt;/td&gt;&lt;td&gt;Subject appears too small&lt;/td&gt;&lt;td&gt;5/10 — Average&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;11&lt;/td&gt;&lt;td&gt;Weak visual contrast&lt;/td&gt;&lt;td&gt;5/10 — Average&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f6f8fb;&quot;&gt;&lt;td&gt;12&lt;/td&gt;&lt;td&gt;Excessive thumbnail text&lt;/td&gt;&lt;td&gt;4/10 — Average&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;13&lt;/td&gt;&lt;td&gt;Vague, unclear image&lt;/td&gt;&lt;td&gt;4/10 — Average&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f6f8fb;&quot;&gt;&lt;td&gt;14&lt;/td&gt;&lt;td&gt;Dull color palette&lt;/td&gt;&lt;td&gt;4/10 — Average&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;15&lt;/td&gt;&lt;td&gt;Cluttered image collage&lt;/td&gt;&lt;td&gt;3/10 — Ineffective&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f6f8fb;&quot;&gt;&lt;td&gt;16&lt;/td&gt;&lt;td&gt;Blurry photograph&lt;/td&gt;&lt;td&gt;3/10 — Ineffective&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;17&lt;/td&gt;&lt;td&gt;Misleading subject&lt;/td&gt;&lt;td&gt;2/10 — Ineffective&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f6f8fb;&quot;&gt;&lt;td&gt;18&lt;/td&gt;&lt;td&gt;Unreadable thumbnail text&lt;/td&gt;&lt;td&gt;2/10 — Ineffective&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;19&lt;/td&gt;&lt;td&gt;Blank image&lt;/td&gt;&lt;td&gt;1/10 — Ineffective&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f6f8fb;&quot;&gt;&lt;td&gt;20&lt;/td&gt;&lt;td&gt;Image unrelated to title&lt;/td&gt;&lt;td&gt;1/10 — Ineffective&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;div style=&quot;margin-top:16px;font-size:13px;&quot;&gt;&lt;b&gt;Accuracy:&lt;/b&gt; Correct results ÷ 20 × 100 = __________%&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=fill;rounded=1;strokeColor=#0f8b8d;strokeWidth=2;fillColor=#ffffff;spacing=20;shadow=1;" vertex="1" parent="1">
