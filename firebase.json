{
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' https://www.gstatic.com https://accounts.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://*.cloudfunctions.net https://accounts.google.com; frame-src https://accounts.google.com https://viewcast-a6f31.firebaseapp.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          }
        ]
      }
    ],
    "ignore": [
      ".git/**",
      ".idea/**",
      ".agents/**",
      ".codex/**",
      ".firebaserc",
      ".firebase-rules-analysis.md",
      ".security-audit-findings.md",
      "functions/**",
      "node_modules/**",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "firestore.rules",
      "firestore.indexes.json",
      "package.json",
      "package-lock.json",
      "skills-lock.json",
      "README.md"
    ],
    "redirects": [
      {
        "source": "/analyzer.html",
        "destination": "/pages/analyzer.html",
        "type": 301
      },
      {
        "source": "/thumbnail-analyzer.html",
        "destination": "/pages/thumbnail-analyzer.html",
        "type": 302
      },
      {
        "source": "/channel.html",
        "destination": "/pages/channel.html",
        "type": 301
      },
      {
        "source": "/insights.html",
        "destination": "/pages/insights.html",
        "type": 301
      },
      {
        "source": "/settings.html",
        "destination": "/pages/settings.html",
        "type": 301
      },
      {
        "source": "/account.html",
        "destination": "/pages/account.html",
        "type": 301
      }
    ]
  },
  "functions": [
    {
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint"
      ],
      "source": "functions"
    }
  ],
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "My App",
        "supportEmail": "justinliu2028@gmail.com"
      }
    }
  }
}
