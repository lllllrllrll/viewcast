{
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      ".git/**",
      ".idea/**",
      ".agents/**",
      ".codex/**",
      "functions/**",
      "node_modules/**",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "firestore.rules",
      "firestore.indexes.json",
      "package.json",
      "package-lock.json",
      "skills-lock.json",
      "README.md"
    ],
    "redirects": [
      {
        "source": "/analyzer.html",
        "destination": "/pages/analyzer.html",
        "type": 301
      },
      {
        "source": "/thumbnail-analyzer",
        "destination": "/thumbnail-analyzer.html",
        "type": 301
      },
      {
        "source": "/pages/thumbnail-analyzer",
        "destination": "/thumbnail-analyzer.html",
        "type": 301
      },
      {
        "source": "/pages/thumbnail-analyzer.html",
        "destination": "/thumbnail-analyzer.html",
        "type": 301
      },
      {
        "source": "/channel.html",
        "destination": "/pages/channel.html",
        "type": 301
      },
      {
        "source": "/insights.html",
        "destination": "/pages/insights.html",
        "type": 301
      },
      {
        "source": "/settings.html",
        "destination": "/pages/settings.html",
        "type": 301
      },
      {
        "source": "/account.html",
        "destination": "/pages/account.html",
        "type": 301
      }
    ]
  },
  "functions": [
    {
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint"
      ],
      "source": "functions"
    }
  ],
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "My App",
        "supportEmail": "justinliu2028@gmail.com"
      }
    }
  }
}
