rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: Firebase Authentication UID
// Fields:
//   - uid: string (required, immutable, matches document owner)
//   - email: string (required, matches the Auth token)
//   - displayName: string (required, 1-100 characters)
//   - updatedAt: timestamp (required, set by the server)
//   - lastSignInAt: timestamp (required)
//   - createdAt: timestamp (optional, immutable after creation)
//   - youtubeConnections: list (optional, at most 5 validated connections)
//   - youtubeConnection: map (optional validated legacy connection)
//     Connections may include bounded ownerData and private Analytics summaries.
//   - channelTopic: string (optional, at most 120 characters)
//   - channelContext: string (optional, at most 1000 characters)
//
// All other paths are denied by default.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated()
        && request.auth.uid == userId;
    }

    function uidUnchanged(userId) {
      return request.resource.data.uid == userId
        && request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return request.resource.data.uid == resource.data.uid;
    }

    function isBoundedString(value, minSize, maxSize) {
      return value is string
        && value.size() >= minSize
        && value.size() <= maxSize;
    }

    function isValidChannel(data) {
      return data is map
        && data.keys().hasOnly([
          'id',
          'title',
          'url',
          'thumbnail',
          'subscriberCount',
          'viewCount',
          'videoCount'
        ])
        && data.keys().hasAll([
          'id',
          'title',
          'url',
          'thumbnail',
          'subscriberCount',
          'viewCount',
          'videoCount'
        ])
        && isBoundedString(data.id, 1, 128)
        && isBoundedString(data.title, 0, 200)
        && isBoundedString(data.url, 1, 500)
        && data.url.matches('^https://www\\.youtube\\.com/channel/.*$')
        && isBoundedString(data.thumbnail, 0, 1000)
        && (data.thumbnail == ''
          || data.thumbnail.matches('^https://.*$'))
        && isBoundedString(data.subscriberCount, 0, 32)
        && isBoundedString(data.viewCount, 0, 32)
        && isBoundedString(data.videoCount, 0, 32);
    }

    function isValidAnalyticsSummary(data) {
      return data is map
        && data.keys().hasOnly([
          'views',
          'estimatedMinutesWatched',
          'averageViewDuration',
          'averageViewPercentage',
          'subscribersGained',
          'subscribersLost',
          'likes',
          'comments',
          'shares',
          'videosAddedToPlaylists',
          'videosRemovedFromPlaylists',
          'estimatedRevenue'
        ])
        && data.keys().hasAll([
          'views',
          'estimatedMinutesWatched',
          'averageViewDuration',
          'subscribersGained'
        ])
        && data.views is number
        && data.views >= 0
        && data.views <= 10000000000000000
        && data.estimatedMinutesWatched is number
        && data.estimatedMinutesWatched >= 0
        && data.estimatedMinutesWatched <= 10000000000000000
        && data.averageViewDuration is number
        && data.averageViewDuration >= 0
        && data.averageViewDuration <= 604800
        && (!('averageViewPercentage' in data)
          || (data.averageViewPercentage is number
            && data.averageViewPercentage >= 0
            && data.averageViewPercentage <= 10000))
        && data.subscribersGained is number
        && data.subscribersGained >= -1000000000000
        && data.subscribersGained <= 1000000000000
        && (!('subscribersLost' in data)
          || (data.subscribersLost is number
            && data.subscribersLost >= 0
            && data.subscribersLost <= 1000000000000))
        && (!('likes' in data)
          || (data.likes is number
            && data.likes >= 0
            && data.likes <= 10000000000000000))
        && (!('comments' in data)
          || (data.comments is number
            && data.comments >= 0
            && data.comments <= 10000000000000000))
        && (!('shares' in data)
          || (data.shares is number
            && data.shares >= 0
            && data.shares <= 10000000000000000))
        && (!('videosAddedToPlaylists' in data)
          || (data.videosAddedToPlaylists is number
            && data.videosAddedToPlaylists >= 0
            && data.videosAddedToPlaylists <= 10000000000000000))
        && (!('videosRemovedFromPlaylists' in data)
          || (data.videosRemovedFromPlaylists is number
            && data.videosRemovedFromPlaylists >= 0
            && data.videosRemovedFromPlaylists <= 10000000000000000))
        && (!('estimatedRevenue' in data)
          || data.estimatedRevenue == null
          || (data.estimatedRevenue is number
            && data.estimatedRevenue >= -1000000000000
            && data.estimatedRevenue <= 1000000000000));
    }

    function isValidOwnerData(data) {
      return data is map
        && data.keys().hasOnly([
          'customUrl',
          'country',
          'description',
          'keywords',
          'privacyStatus',
          'longUploadsStatus',
          'isLinked',
          'madeForKids',
          'selfDeclaredMadeForKids',
          'uploadsPlaylistId',
          'analyticsAccess',
          'monetaryAnalyticsAccess'
        ])
        && data.keys().hasAll([
          'customUrl',
          'country',
          'description',
          'keywords',
          'privacyStatus',
          'longUploadsStatus',
          'isLinked',
          'madeForKids',
          'selfDeclaredMadeForKids',
          'uploadsPlaylistId',
          'analyticsAccess',
          'monetaryAnalyticsAccess'
        ])
        && isBoundedString(data.customUrl, 0, 200)
        && isBoundedString(data.country, 0, 8)
        && isBoundedString(data.description, 0, 2000)
        && isBoundedString(data.keywords, 0, 1000)
        && isBoundedString(data.privacyStatus, 0, 32)
        && isBoundedString(data.longUploadsStatus, 0, 32)
        && isBoundedString(data.uploadsPlaylistId, 0, 128)
        && data.isLinked is bool
        && data.madeForKids is bool
        && data.selfDeclaredMadeForKids is bool
        && data.analyticsAccess is bool
        && data.monetaryAnalyticsAccess is bool;
    }

    function isValidConnection(data) {
      return data is map
        && data.keys().hasOnly([
          'channel',
          'ownerData',
          'analyticsSummary',
          'connectedAt'
        ])
        && data.keys().hasAll([
          'channel',
          'analyticsSummary',
          'connectedAt'
        ])
        && isValidChannel(data.channel)
        && (!('ownerData' in data) || isValidOwnerData(data.ownerData))
        && (data.analyticsSummary == null
          || isValidAnalyticsSummary(data.analyticsSummary))
        && data.connectedAt is int
        && data.connectedAt >= 946684800000
        && data.connectedAt <= request.time.toMillis() + 300000;
    }

    function isValidConnectionAt(connections, index) {
      return connections.size() <= index
        || isValidConnection(connections[index]);
    }

    function isValidConnections(connections) {
      return connections is list
        && connections.size() <= 5
        && isValidConnectionAt(connections, 0)
        && isValidConnectionAt(connections, 1)
        && isValidConnectionAt(connections, 2)
        && isValidConnectionAt(connections, 3)
        && isValidConnectionAt(connections, 4);
    }

    function hasValidOptionalConnectionFields(data) {
      return (!('youtubeConnections' in data)
          || isValidConnections(data.youtubeConnections))
        && (!('youtubeConnection' in data)
          || isValidConnection(data.youtubeConnection));
    }

    function hasValidOptionalChannelContext(data) {
      return (!('channelTopic' in data)
          || (data.channelTopic is string
            && data.channelTopic.size() <= 120))
        && (!('channelContext' in data)
          || (data.channelContext is string
            && data.channelContext.size() <= 1000));
    }

    function isValidUser(data) {
      return data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'updatedAt',
          'lastSignInAt',
          'createdAt',
          'youtubeConnections',
          'youtubeConnection',
          'channelTopic',
          'channelContext'
        ])
        && data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'updatedAt',
          'lastSignInAt'
        ])
        && data.uid is string
        && data.uid.size() > 0
        && data.uid.size() <= 128
        && data.email is string
        && data.email == request.auth.token.email
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && data.updatedAt is timestamp
        && data.updatedAt == request.time
        && data.lastSignInAt is timestamp
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && hasValidOptionalConnectionFields(data)
        && hasValidOptionalChannelContext(data);
    }

    function hasValidCreateTimestamps(data) {
      return data.createdAt == request.time
        && data.lastSignInAt == request.time;
    }

    function hasValidUpdateTimestamps(data) {
      return (('createdAt' in resource.data)
          && data.createdAt == resource.data.createdAt
          || !('createdAt' in resource.data)
          && !('createdAt' in data))
        && (data.lastSignInAt == resource.data.lastSignInAt
          || data.lastSignInAt == request.time);
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
        && uidUnchanged(userId)
        && isValidUser(request.resource.data)
        && hasValidCreateTimestamps(request.resource.data);

      allow read: if isOwner(userId);

      allow update: if isOwner(userId)
        && uidNotModified()
        && isValidUser(request.resource.data)
        && hasValidUpdateTimestamps(request.resource.data);

      allow delete: if isOwner(userId);
    }

    // YouTube refresh tokens remain unreadable and unwritable from the client.
    // The owner may only remove their own credential while deleting the account.
    match /_internalYouTubeAuth/{userId} {
      allow read, create, update: if false;
      allow delete: if isOwner(userId);
    }
  }
}
